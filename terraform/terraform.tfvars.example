# Copy to terraform.tfvars and adjust.

name   = "demo-eks-karpenter"
region = "eu-west-1"

kubernetes_version = "1.36"

vpc_cidr = "10.0.0.0/16"
az_count = 3

# true  = one NAT gateway for the VPC (cheaper, single point of failure)
# false = one per AZ (production)
single_nat_gateway = true

# Ceiling on vCPUs Karpenter may provision, as a cost guardrail.
node_cpu_limit = 100

# Narrow this to your office / VPN ranges for anything beyond a POC.
endpoint_public_access_cidrs = ["0.0.0.0/0"]

tags = {
  Owner = "platform-team"
}
